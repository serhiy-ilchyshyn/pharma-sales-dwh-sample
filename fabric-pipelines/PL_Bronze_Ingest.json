                                    "type": "AzureSqlSource",
                                    "sqlReaderQuery": {
                                        "value": "select cast(N'@{if(empty(pipeline().parameters.executor_run_id), pipeline().RunId, pipeline().parameters.executor_run_id)}' as [varchar](36)) as [TechExecutorRunID],\n\tcast(N'@{pipeline().RunId}' as [varchar](36)) as [TechProcessorRunID],\n\tconvert(datetime, N'@{variables('processing_datetime')}', 120) as [TechProcessingDateTime],\n\tconvert(datetime, N'@{if(empty(pipeline().parameters.business_datetime), variables('processing_datetime'), pipeline().parameters.business_datetime)}', 120) as [TechBusinessDateTime],\n\t*\nfrom [@{item().SourceSchema}].[@{item().SourceTable}]",
