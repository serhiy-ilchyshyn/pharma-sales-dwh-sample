{
  "_comment": [
    "Fabric Data Pipeline: Azure SQL [erp].* -> bronze lakehouse [lhbronze].[erp_erp].* -> тригер silver.",
    "Параметр source_table: '' = усі 10 таблиць + повне завантаження silver;",
    "'CUSTOMERS' = перекопіювати лише цю таблицю і перевантажити silver-обʼєкти, що від неї залежать",
    "(root_object = 'lhbronze.erp_erp.CUSTOMERS' передається у PL_Silver_Full_Load).",
    "Lookup читає перелік таблиць з [dwh].[EtlBronzeObject], ForEach (паралельно, batchCount=4)",
    "копіює кожну таблицю з режимом Overwrite, після успіху Invoke pipeline запускає silver і чекає завершення.",
    "ПЕРЕД ІМПОРТОМ підставити: <AZURE_SQL_CONNECTION_ID>, <BRONZE_LAKEHOUSE_ITEM_ID>,",
    "<SILVER_PIPELINE_ITEM_ID>, <FABRIC_PIPELINE_CONNECTION_ID>."
  ],
  "properties": {
    "activities": [
      {
        "name": "LookupBronzeObjects",
        "type": "Lookup",
        "dependsOn": [],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "DataWarehouseSource",
            "sqlReaderQuery": {
              "value": "SELECT SourceSchema, SourceTable, TargetSchema, TargetTable, LoadMode FROM [dwh].[EtlBronzeObject] WHERE IsActive = 1 AND ('@{pipeline().parameters.source_table}' = '' OR SourceTable = '@{pipeline().parameters.source_table}') ORDER BY SourceTable",
              "type": "Expression"
            },
            "queryTimeout": "02:00:00",
            "partitionOption": "None",
            "datasetSettings": {
              "type": "DataWarehouseTable",
              "typeProperties": {},
              "annotations": [],
              "linkedService": {
                "name": "whsilver",
                "properties": {
                  "type": "DataWarehouse",
                  "annotations": [],
                  "typeProperties": {
                    "endpoint": "viqr2bflwtiuvci5miqhwm3h54-l62twngicguehlf2hljthiwqpi.datawarehouse.fabric.microsoft.com",
                    "artifactId": "578fc162-5aac-4981-be73-f6a3e928aabf",
                    "workspaceId": "343bb55f-11c8-43a8-acba-3ad333a2d07a"
                  }
                }
              }
            }
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "ForEachBronzeTable",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "LookupBronzeObjects",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('LookupBronzeObjects').output.value",
            "type": "Expression"
          },
          "isSequential": false,
          "batchCount": 4,
          "activities": [
            {
              "name": "CopyErpTableToBronze",
              "type": "Copy",
              "dependsOn": [],
              "policy": {
                "timeout": "0.02:00:00",
                "retry": 2,
                "retryIntervalInSeconds": 120,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "source": {
                  "type": "AzureSqlSource",
                  "sqlReaderQuery": {
                    "value": "SELECT * FROM [@{item().SourceSchema}].[@{item().SourceTable}]",
                    "type": "Expression"
                  },
                  "queryTimeout": "02:00:00",
                  "partitionOption": "None",
                  "datasetSettings": {
                    "type": "AzureSqlTable",
                    "typeProperties": {
                      "schema": {
                        "value": "@item().SourceSchema",
                        "type": "Expression"
                      },
                      "table": {
                        "value": "@item().SourceTable",
                        "type": "Expression"
                      }
                    },
                    "externalReferences": {
                      "connection": "viqr2bflwtiuvci5miqhwm3h54-l62twngicguehlf2hljthiwqpi.datawarehouse.fabric.microsoft.com"
                    },
                    "annotations": []
                  }
                },
                "sink": {
                  "type": "LakehouseTableSink",
                  "tableActionOption": "Overwrite",
                  "datasetSettings": {
                    "type": "LakehouseTable",
                    "typeProperties": {
                      "schema": {
                        "value": "@item().TargetSchema",
                        "type": "Expression"
                      },
                      "table": {
                        "value": "@item().TargetTable",
                        "type": "Expression"
                      }
                    },
                    "annotations": [],
                    "linkedService": {
                      "name": "lhbronze",
                      "properties": {
                        "type": "Lakehouse",
                        "annotations": [],
                        "typeProperties": {
                          "artifactId": "6c4fcfc9-dc85-4d5e-89b7-7d362bf87501",
                          "workspaceId": "343bb55f-11c8-43a8-acba-3ad333a2d07a",
                          "rootFolder": "Tables"
                        }
                      }
                    }
                  }
                },
                "enableStaging": false,
                "translator": {
                  "type": "TabularTranslator",
                  "typeConversion": true,
                  "typeConversionSettings": {
                    "allowDataTruncation": false,
                    "treatBooleanAsNumber": false
                  }
                }
              }
            }
          ]
        }
      },
      {
        "name": "InvokeSilverFullLoad",
        "type": "InvokePipeline",
        "dependsOn": [
          {
            "activity": "ForEachBronzeTable",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "policy": {
          "timeout": "0.04:00:00",
          "retry": 0,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "operationType": "InvokeFabricPipeline",
          "workspaceId": "343bb55f-11c8-43a8-acba-3ad333a2d07a",
          "pipelineId": "a5d81645-aff3-45de-b4f5-5d05c95271fb",
          "waitOnCompletion": true,
          "parameters": {
            "root_object": {
              "value": "@if(empty(pipeline().parameters.source_table), '', concat('lhbronze.erp_erp.', pipeline().parameters.source_table))",
              "type": "Expression"
            }
          }
        },
        "externalReferences": {
          "connection": "viqr2bflwtiuvci5miqhwm3h54-l62twngicguehlf2hljthiwqpi.datawarehouse.fabric.microsoft.com"
        }
      }
    ],
    "annotations": [],
    "lastModifiedByObjectId": "",
    "lastPublishTime": "",
    "parameters": {
      "source_table": {
        "type": "string",
        "defaultValue": ""
      }
    }
  }
}
