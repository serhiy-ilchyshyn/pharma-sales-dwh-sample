{
  "_comment": [
    "Fabric Data Pipeline: metadata-driven завантаження silver.",
    "Параметр root_object: '' = повне завантаження; 'lhbronze.erp_erp.CUSTOMERS' або 'dwh.DimRegion'",
    "= перевантажити лише цей обʼєкт і все, що з нього походить (замикання з [dwh].[EtlObjectDownstream]).",
    "Lookup читає рівні з [dwh].[EtlSilverObject], ForEach (послідовно) викликає",
    "[dwh].[spSilverLoadLevel] для кожного рівня, load_id = RunId запуску pipeline.",
    "Новий обʼєкт silver = рядок у EtlSilverObject; pipeline змінювати не потрібно."
  ],
  "properties": {
    "activities": [
      {
        "name": "LookupLoadLevels",
        "type": "Lookup",
        "dependsOn": [],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "DataWarehouseSource",
            "sqlReaderQuery": {
              "value": "SELECT DISTINCT o.LoadLevel FROM [dwh].[EtlSilverObject] o WHERE o.IsActive = 1 AND ('@{pipeline().parameters.root_object}' = '' OR EXISTS (SELECT 1 FROM [dwh].[EtlObjectDownstream] d WHERE d.ObjectName = o.ObjectName AND d.RootObject = '@{pipeline().parameters.root_object}')) ORDER BY o.LoadLevel",
              "type": "Expression"
            },
            "queryTimeout": "02:00:00",
            "partitionOption": "None",
            "datasetSettings": {
              "type": "DataWarehouseTable",
              "typeProperties": {},
              "annotations": [],
              "linkedService": {
                "name": "whsilver",
                "properties": {
                  "type": "DataWarehouse",
                  "annotations": [],
                  "typeProperties": {
                    "endpoint": "viqr2bflwtiuvci5miqhwm3h54-l62twngicguehlf2hljthiwqpi.datawarehouse.fabric.microsoft.com",
                    "artifactId": "578fc162-5aac-4981-be73-f6a3e928aabf",
                    "workspaceId": "343bb55f-11c8-43a8-acba-3ad333a2d07a"
                  }
                }
              }
            }
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "ForEachLoadLevel",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "LookupLoadLevels",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('LookupLoadLevels').output.value",
            "type": "Expression"
          },
          "isSequential": true,
          "activities": [
            {
              "name": "ExecSilverLoadLevel",
              "type": "Script",
              "dependsOn": [],
              "policy": {
                "timeout": "0.02:00:00",
                "retry": 1,
                "retryIntervalInSeconds": 120,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "scripts": [
                  {
                    "type": "Query",
                    "text": {
                      "value": "EXEC [dwh].[spSilverLoadLevel] @level = @{item().LoadLevel}, @load_id = '@{pipeline().RunId}', @root_object = '@{pipeline().parameters.root_object}';",
                      "type": "Expression"
                    }
                  }
                ],
                "scriptBlockExecutionTimeout": "02:00:00"
              },
              "linkedService": {
                "name": "whsilver",
                "properties": {
                  "type": "DataWarehouse",
                  "annotations": [],
                  "typeProperties": {
                    "endpoint": "viqr2bflwtiuvci5miqhwm3h54-l62twngicguehlf2hljthiwqpi.datawarehouse.fabric.microsoft.com",
                    "artifactId": "578fc162-5aac-4981-be73-f6a3e928aabf",
                    "workspaceId": "343bb55f-11c8-43a8-acba-3ad333a2d07a"
                  }
                }
              }
            }
          ]
        }
      }
    ],
    "annotations": [],
    "lastModifiedByObjectId": "",
    "lastPublishTime": "",
    "parameters": {
      "root_object": {
        "type": "string",
        "defaultValue": ""
      }
    }
  }
}
