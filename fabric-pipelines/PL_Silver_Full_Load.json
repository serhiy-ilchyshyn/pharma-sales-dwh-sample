{
  "_comment": [
    "Fabric Data Pipeline: metadata-driven завантаження silver.",
    "Lookup читає рівні з [dwh].[EtlSilverObject], ForEach (послідовно) викликає",
    "[dwh].[spSilverLoadLevel] для кожного рівня, load_id = RunId запуску pipeline.",
    "Новий об'єкт silver = рядок у EtlSilverObject; pipeline змінювати не потрібно.",
    "ПЕРЕД ІМПОРТОМ: підставити <FABRIC_WORKSPACE_ID>, <WAREHOUSE_ITEM_ID>, <SQL_ENDPOINT>",
    "JSON — шаблон; якщо версія Fabric очікує іншу структуру linkedService, простіше",
    "зібрати ці 2 активності в UI і вставити SQL з полів typeProperties (див. docs/silver_model.md)."
  ],
  "properties": {
    "activities": [
      {
        "name": "LookupLoadLevels",
        "type": "Lookup",
        "dependsOn": [],
        "policy": {
          "timeout": "0.01:00:00",
          "retry": 1,
          "retryIntervalInSeconds": 60,
          "secureOutput": false,
          "secureInput": false
        },
        "typeProperties": {
          "source": {
            "type": "DataWarehouseSource",
            "sqlReaderQuery": "SELECT DISTINCT LoadLevel FROM [dwh].[EtlSilverObject] WHERE IsActive = 1 ORDER BY LoadLevel",
            "queryTimeout": "02:00:00",
            "partitionOption": "None",
            "datasetSettings": {
              "type": "DataWarehouseTable",
              "typeProperties": {},
              "annotations": [],
              "linkedService": {
                "name": "whsilver",
                "properties": {
                  "type": "DataWarehouse",
                  "annotations": [],
                  "typeProperties": {
                    "endpoint": "viqr2bflwtiuvci5miqhwm3h54-l62twngicguehlf2hljthiwqpi.datawarehouse.fabric.microsoft.com",
                    "artifactId": "578fc162-5aac-4981-be73-f6a3e928aabf",
                    "workspaceId": "343bb55f-11c8-43a8-acba-3ad333a2d07a"
                  }
                }
              }
            }
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "ForEachLoadLevel",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "LookupLoadLevels",
            "dependencyConditions": ["Succeeded"]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('LookupLoadLevels').output.value",
            "type": "Expression"
          },
          "isSequential": true,
          "activities": [
            {
              "name": "ExecSilverLoadLevel",
              "type": "Script",
              "dependsOn": [],
              "policy": {
                "timeout": "0.02:00:00",
                "retry": 1,
                "retryIntervalInSeconds": 120,
                "secureOutput": false,
                "secureInput": false
              },
              "typeProperties": {
                "scripts": [
                  {
                    "type": "Query",
                    "text": {
                      "value": "EXEC [dwh].[spSilverLoadLevel] @level = @{item().LoadLevel}, @load_id = '@{pipeline().RunId}';",
                      "type": "Expression"
                    }
                  }
                ],
                "scriptBlockExecutionTimeout": "02:00:00"
              },
              "linkedService": {
                "name": "whsilver",
                "properties": {
                  "type": "DataWarehouse",
                  "annotations": [],
                  "typeProperties": {
                    "endpoint": "viqr2bflwtiuvci5miqhwm3h54-l62twngicguehlf2hljthiwqpi.datawarehouse.fabric.microsoft.com",
                    "artifactId": "578fc162-5aac-4981-be73-f6a3e928aabf",
                    "workspaceId": "343bb55f-11c8-43a8-acba-3ad333a2d07a"
                  }
                }
              }
            }
          ]
        }
      }
    ],
    "annotations": [],
    "lastModifiedByObjectId": "",
    "lastPublishTime": ""
  }
}
