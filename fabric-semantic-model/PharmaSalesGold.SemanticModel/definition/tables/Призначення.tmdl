		summarizeBy: none
		sourceColumn: MonthStartDate
		annotation SummarizationSetBy = Automatic
		annotation UnderlyingDateTimeDataType = Date

	measure Призначення = SUM('Призначення'[TotalPrescriptionsCnt])
		formatString: #,0
		lineageTag: 37c0e206-5bb9-507c-b5f4-21497ef2327e

	measure Пацієнти = SUM('Призначення'[TotalPatientsCnt])
		formatString: #,0
		lineageTag: 249d15f3-471e-5e39-89ab-302912d0bf9f

	measure 'Призначень на пацієнта' = DIVIDE([Призначення], [Пацієнти])
		formatString: #,0.00
		lineageTag: f9110036-820a-525f-a5f0-b23adee93ae5

	/// Розраховано в межах місяця; за кількох місяців одразу показує порожньо.
	measure 'Лікарів, що призначали (місяць)' = IF(HASONEVALUE('Призначення'[YearMonth]), SUM('Призначення'[DoctorCnt]))
		formatString: #,0
		lineageTag: ad615979-086e-5555-b816-cfa743535fa5

	partition 'Призначення' = entity
		mode: directLake
		source
			entityName: AggPrescriptionMonthly
			schemaName: dwh
			expressionSource: DatabaseQuery
