		summarizeBy: none
		sourceColumn: TotalPrescriptionsCnt
		annotation SummarizationSetBy = Automatic

	column TotalPatientsCnt
		dataType: int64
		isHidden
		lineageTag: 634e4a22-4d49-5739-8532-17ae9c74d8ca
		summarizeBy: none
		sourceColumn: TotalPatientsCnt
		annotation SummarizationSetBy = Automatic

	column YearMonth
		dataType: string
		isHidden
		lineageTag: 781ae0cc-c5ef-59db-86c2-139ef980cf53
