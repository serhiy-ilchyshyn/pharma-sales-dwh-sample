	/// Критична серйозність із наслідком «одужав»
	measure 'Логічні помилки в кейсах' = SUM('Побічні явища'[LogicalErrorCnt])
		formatString: #,0
		lineageTag: b40116d9-f7d1-5798-9fdf-610b0896e8c7

	partition 'Побічні явища' = entity
