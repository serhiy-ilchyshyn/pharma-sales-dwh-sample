	/// Включає повернення (статус RETURN)
	measure 'Сума продажів за день' = SUM('Продажі за день'[TotalNetAmount])
		formatString: #,0
		lineageTag: 3bf1677a-2b02-5830-bf9b-df131685f512

	measure 'Кількість упаковок за день' = SUM('Продажі за день'[TotalQty])
		formatString: #,0
		lineageTag: 37ceda4d-ed37-5fd8-ac27-ce1d36e3924b

	measure 'Сума до знижки' = SUM('Продажі за день'[TotalGrossAmount])
		formatString: #,0
		lineageTag: 4130c3c5-847f-599c-9054-efc5a8c949ec

	measure 'Сума знижок' = SUM('Продажі за день'[TotalDiscountAmount])
		formatString: #,0
		lineageTag: 8bcf82ed-17a4-5bb4-873f-e47a09d47367

	measure 'Середня знижка, %' = DIVIDE(SUM('Продажі за день'[TotalDiscountAmount]), SUM('Продажі за день'[TotalGrossAmount]))
		formatString: 0.0%
		lineageTag: 616246f5-b8bb-53dc-b97e-e24a758c218f

	/// Коректно рахується на будь-якому рівні — за день, місяць чи рік
	measure 'Клієнтів, що купували' = DISTINCTCOUNT('Продажі за день'[SKClientAccountID])
		formatString: #,0
		lineageTag: 561d9e91-8b9f-53b0-a67c-080bc0dd921b

	partition 'Продажі за день' = entity
		mode: directLake
		source
			entityName: AggSalesDaily
			schemaName: dwh
			expressionSource: DatabaseQuery
