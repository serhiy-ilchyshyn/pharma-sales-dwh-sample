	/// Сума без повернень, грн
	measure 'Сума продажів' = SUM('Продажі за місяць'[TotalNetAmount])
		formatString: #,0
		lineageTag: f5eb87db-a9e2-5590-ab5d-4d7347301a20

	/// Продані упаковки без повернень
	measure 'Кількість упаковок' = SUM('Продажі за місяць'[TotalQty])
		formatString: #,0
		lineageTag: 0cf596f1-1743-511f-8ad2-c19be75096cf

	measure 'Рядків замовлень' = SUM('Продажі за місяць'[OrderLineCnt])
		formatString: #,0
		lineageTag: 5e309b41-234f-58cc-ade6-20500fa5a71f

	/// Сума повернень, грн
	measure 'Повернення, сума' = SUM('Продажі за місяць'[ReturnNetAmount])
		formatString: #,0
		lineageTag: 0106b3e3-4315-5af8-8490-29c10a88d1ae

	measure 'Повернення, упаковки' = SUM('Продажі за місяць'[ReturnQty])
		formatString: #,0
		lineageTag: 35f1e5bb-6d97-5da3-9d71-780fade2e596

	/// Повернення до валового обороту
	measure 'Частка повернень' = DIVIDE([Повернення, сума], [Сума продажів] + [Повернення, сума])
		formatString: 0.0%
		lineageTag: 0e0c0807-a85b-559e-9d7f-f7ac1b28b211

	measure 'Середня сума рядка' = DIVIDE([Сума продажів], [Рядків замовлень])
		formatString: #,0.00
		lineageTag: d8abf452-fa52-59c4-b4b6-a4b1eb461ce1

	partition 'Продажі за місяць' = entity
		mode: directLake
		source
			entityName: AggSalesMonthly
			schemaName: dwh
			expressionSource: DatabaseQuery
