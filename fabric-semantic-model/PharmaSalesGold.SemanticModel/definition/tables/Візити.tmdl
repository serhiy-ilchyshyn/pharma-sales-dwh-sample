	measure Візити = SUM('Візити'[VisitCnt])
		formatString: #,0
		lineageTag: 1105f711-0c71-574c-8469-a26e8cb04bde

	measure 'Тривалість візитів, хв' = SUM('Візити'[TotalDurationMin])
		formatString: #,0
		lineageTag: b137fbb5-47c3-58c8-b07d-c6762adeaf92

	/// Хвилин
	measure 'Середня тривалість візиту' = DIVIDE([Тривалість візитів, хв], [Візити])
		formatString: #,0.0
		lineageTag: cd38b526-d53f-5a1d-b960-26b446994637

	measure 'Роздано зразків' = SUM('Візити'[TotalSamplesQty])
		formatString: #,0
		lineageTag: 3b8ddeeb-e857-5424-b12b-5aee622e4819

	/// Розраховано в межах місяця. За кількох місяців одразу показує порожньо — лікарі повторюються і сума була б завищена.
	measure 'Лікарів охоплено (місяць)' = IF(HASONEVALUE('Візити'[YearMonth]), SUM('Візити'[DoctorCnt]))
		formatString: #,0
		lineageTag: eebeda69-ed9f-5320-bbee-fa014d6bc3a2

	partition 'Візити' = entity
		mode: directLake
		source
			entityName: AggVisitMonthly
			schemaName: dwh
			expressionSource: DatabaseQuery
