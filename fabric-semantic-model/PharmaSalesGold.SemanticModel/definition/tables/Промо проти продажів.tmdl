/// Візити, зразки, призначення й продажі зведені до спільного розрізу: місяць × препарат × регіон.
table 'Промо проти продажів'
	lineageTag: b4af1c38-be1e-5b4b-b4c8-f01d41ba9c27

	column CreatedBy
		dataType: string
		isHidden
		lineageTag: a1a3f204-930a-5bee-96bd-b44a6227b746
		summarizeBy: none
		sourceColumn: CreatedBy
		annotation SummarizationSetBy = Automatic

	column CreatedAt
		dataType: dateTime
		isHidden
		lineageTag: 07255cc9-5767-5a99-a1bb-c1d1c54b0c8f
		summarizeBy: none
		sourceColumn: CreatedAt
		annotation SummarizationSetBy = Automatic
		annotation UnderlyingDateTimeDataType = Date

