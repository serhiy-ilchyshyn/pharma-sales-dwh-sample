	column MonthStartDate
		dataType: dateTime
		isHidden
		lineageTag: 76d55ea5-d9f3-5ead-8d0e-6943b7a07054
		summarizeBy: none
		sourceColumn: MonthStartDate
		annotation SummarizationSetBy = Automatic
		annotation UnderlyingDateTimeDataType = Date

	measure 'Промо: візити' = SUM('Промо проти продажів'[VisitCnt])
		formatString: #,0
		lineageTag: 7f0e85b7-5278-561d-8931-e7e1a51f0363

	measure 'Промо: зразки' = SUM('Промо проти продажів'[TotalSamplesQty])
		formatString: #,0
		lineageTag: b3077093-6825-5175-961a-efe562c7871f

	measure 'Промо: призначення' = SUM('Промо проти продажів'[TotalPrescriptionsCnt])
		formatString: #,0
		lineageTag: 20df5405-d859-52a0-9731-e5eda9b0d479

	measure 'Промо: сума продажів' = SUM('Промо проти продажів'[TotalNetAmount])
		formatString: #,0
		lineageTag: 5f1f9697-3081-5df4-b058-77865cd7f48a

	/// Відношення, а не сума: перераховується на кожному рівні, тому підсумовувати його не можна.
	measure 'Сума продажів на візит' = DIVIDE([Промо: сума продажів], [Промо: візити])
		formatString: #,0.00
		lineageTag: 2df36ff5-48f9-505c-8979-f1cf96f9796d

	partition 'Промо проти продажів' = entity
		mode: directLake
		source
			entityName: AggPromoEffectMonthly
			schemaName: dwh
			expressionSource: DatabaseQuery
